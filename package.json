    "agents:skills": "node scripts/agents/sync/sync-agent-skills.mjs",
    "agents:skills:check": "node scripts/agents/sync/sync-agent-skills.mjs --check",
    "agents:skills:status": "node scripts/agents/sync/sync-agent-skills.mjs --status",
    "typecheck:agents": "tsc -p tsconfig.agents.json --noEmit --skipLibCheck"
  },
  "dependencies": {
