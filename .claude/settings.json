{
  "description": "Generated from .agents/sync-policy.json. Do not edit. Run pnpm agents:providers.",
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Bash(pnpm dev:agent:*)",
      "Bash(pnpm test:e2e:*)",
      "Bash(pnpm exec playwright:*)",
      "Bash(pnpm exec tsc:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/.agents/hooks/guard-frontend.mjs",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
